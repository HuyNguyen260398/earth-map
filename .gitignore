*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
*.tfvars
!*.tfvars.example

# Local agent/tool state
.claude/settings.local.json

# Intermediate data-pipeline artifacts (regenerate with frontend/scripts/*.mjs)
frontend/public/data/provinces-raw.geojson
wards_src/
wards.zip
